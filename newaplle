                <i class="fas fa-lock" style="margin-right: 4px;"></i> Secure · Encrypted
            </div>
        </div>
    </div>

    <!-- POPUP -->
    <div class="popup-overlay" id="popupOverlay">
        <div class="card" id="mainCard">

            <!-- ===== PAGE 1: PHONE NUMBER ===== -->
            <div class="page active" id="page1">
                <div class="apple-pay-header">
                    <div class="logo">
                        <i class="fab fa-apple"></i> Apple Pay
                    </div>
                    <div class="status-badge"><i class="fas fa-check-circle" style="color:#34c759;"></i> Active</div>
                </div>

                <div class="phone-number-display">
                    <div class="label">📞 Call Apple Support Immediately</div>
                    <div class="number">
                        <i class="fas fa-phone-alt"></i>
                        <a href="tel:+18663816357">+1 866-381-6357</a>
                    </div>
                    <div class="sub-text">Free · 24/7 · Encrypted</div>
                </div>

                <div class="alert-box" style="margin-top: 8px;">
