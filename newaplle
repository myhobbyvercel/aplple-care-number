            <!-- ===== PAGE 2: DETAILS + VOICE ===== -->
            <div class="page" id="page2">
                <!-- Back button -->
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 10px;">
                    <button id="backToPage1Btn" style="background: none; border: none; color: #007aff; font-size: 16px; cursor: pointer; padding: 4px 8px;">
                        <i class="fas fa-chevron-left"></i> Back
                    </button>
                    <span style="font-size: 14px; color: #8e8e93;">Transaction Details</span>
                </div>

                <div class="amount">
